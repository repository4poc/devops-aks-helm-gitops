{
  "name": "node-backend",
  "version": "1.0.0",
  "description": "Simple Node.js Express backend",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist');fs.copyFileSync('server.js','dist/server.js');fs.copyFileSync('package.json','dist/package.json')\"",
    "start": "node dist/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^4.21.0",
    "nodemon": "^3.1.14",
    "vtest": "^1.1.0"
  }
}
